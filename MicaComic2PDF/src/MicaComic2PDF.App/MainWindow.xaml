<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MicaComic2PDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MicaComic2PDF.App"
    xmlns:vm="using:MicaComic2PDF.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mica Comic2PDF"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <TitleBar x:Name="AppTitleBar" Title="Mica Comic2PDF">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：设置 -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">

                <StackPanel Spacing="10">

                    <CheckBox Content="自动切页" IsChecked="{Binding AutoSplit, Mode=TwoWay}" />

                    <ContentControl IsEnabled="{Binding AutoSplit}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="开页方式"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                            <RadioButtons Grid.Row="1"
                                          ItemsSource="{Binding SplitOptions}"
                                          SelectedItem="{Binding SelectedSplit, Mode=TwoWay}">
                                <RadioButtons.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Display}" />
                                    </DataTemplate>
                                </RadioButtons.ItemTemplate>
                            </RadioButtons>
                        </Grid>
                    </ContentControl>

                    <TextBlock Text="输出格式" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ComboBox ItemsSource="{Binding AvailableFormats}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="最大边长 (px)" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <NumberBox Minimum="0" Maximum="20000" SmallChange="256"
                               Value="{Binding MaxEdge, Mode=TwoWay}" />
                    <TextBlock Text="0 = 原图不缩放"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="质量" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <Slider Minimum="1" Maximum="100" TickFrequency="5"
                            Value="{Binding Quality, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center" Text="{Binding Quality}" />

                    <TextBlock Text="输出目录" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBox PlaceholderText="留空 = 源文件夹内"
                             Text="{Binding OutputDirectory, Mode=TwoWay}" />

                    <StackPanel Height="8" />

                    <Button Content="开始转换"
                            Command="{Binding StartConvertCommand}"
                            IsEnabled="{Binding IsConverting, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}" />

                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue}" />
                </StackPanel>
            </Border>

            <!-- 右栏：任务列表 + 日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        AllowDrop="True"
                        DragOver="TaskList_DragOver"
                        Drop="TaskList_Drop"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                            <Button Grid.Column="1" Content="添加任务" Click="BtnAdd_Click" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="移除选中" Click="BtnRemove_Click"
                                    IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                            <Button Grid.Column="3" Content="清空" Click="BtnClear_Click"
                                    IsEnabled="{Binding HasFolders}" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="TaskListView"
                                  ItemsSource="{Binding Folders}"
                                  SelectionMode="Multiple"
                                  SelectionChanged="TaskListView_SelectionChanged"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FolderName}" />
                                            <TextBlock Text="{Binding FolderPath}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                                   Width="60" Margin="0,0,8,0"
                                                   Text="{Binding ImageCountLabel}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Width="70"
                                                   Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="140">

                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="日志"
                                   Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBox Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding LogText, Mode=OneWay}"
                                 FontFamily="Consolas" FontSize="12" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
